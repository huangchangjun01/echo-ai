# ====================== Echo-AI 配置 ======================

# ---------- Weaviate ----------
WEAVIATE_HOST=8.130.81.41:8080
WEAVIATE_SCHEME=http
WEAVIATE_PORT=8080
WEAVIATE_CLASS=EchoDoc
WEAVIATE_MEMORY_CLASS=EchoMemory
# WEAVIATE_API_KEY 留空

# ---------- 七牛云 ----------
QINIU_BASE_URL=tixapmuo5.hn-bkt.clouddn.com
# QINIU_ALLOWED_SUBDOMAINS 留空（不要在 .env 留空行，否则 pydantic-settings 会尝试 JSON 解析）

# ---------- MySQL ----------
DB_HOST=8.130.81.41
DB_PORT=3306
DB_USER=root
DB_PASSWORD=10010hcj
DB_NAME=huangchangjun
DB_POOL_MIN=1
DB_POOL_MAX=10

# ---------- LLM (OpenAI 兼容) ----------
# 大小模型分工：小模型负责「日常对话」，大模型负责「记忆抽取 / 摘要 / 内容描述」等生成任务。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-a3da776a3acc41ab9276bb506cf7db18

# 大模型：用于记忆抽取 / 摘要生成 / 图文音视频内容描述等后台生成任务
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# 小模型：用于日常对话（方案A：单一小模型直接流式生成回复，首字延迟敏感）
LLM_SMALL_MODEL=deepseek-v4-flash
LLM_SMALL_MAX_TOKENS=1024
LLM_SMALL_TEMPERATURE=0.5
LLM_SMALL_BASE_URL=https://api.deepseek.com/v1
LLM_SMALL_API_KEY=sk-a3da776a3acc41ab9276bb506cf7db18

# ---------- Embedding ----------
EMBEDDING_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CHUNK_SIZE=256
EMBEDDING_CHUNK_OVERLAP=32
EMBEDDING_WARMUP_ON_START=true
# HF 镜像：国内部署必须设，否则直连 huggingface.co 会被 GFW 阻断，
# 表现为 SSL: UNEXPECTED_EOF_WHILE_READING + 5 次重试后 fallback。
EMBEDDING_ENDPOINT=https://hf-mirror.com
EMBEDDING_DOWNLOAD_TIMEOUT=15
# 模型已经在 ~/.cache/huggingface 时设 true，禁用任何外网请求
EMBEDDING_LOCAL_FILES_ONLY=false

# BGE-M3 文本向量（实际 1024 维）
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DIM=1024
BGE_M3_DEVICE=auto
BGE_M3_ENDPOINT=https://hf-mirror.com
BGE_M3_DOWNLOAD_TIMEOUT=15
BGE_M3_LOCAL_FILES_ONLY=false

# ---------- 记忆系统 ----------
MEMORY_L0_LIMIT=20
MEMORY_L1_TOPK=8
MEMORY_L2_TOPK=20
MEMORY_DEDUP_THRESHOLD=0.92
MEMORY_REACT_MAX_ITER=3
MEMORY_ENABLE_ASYNC_EXTRACT=true

# ---------- Ingest ----------
INGEST_MAX_DOWNLOAD_BYTES=52428800
INGEST_DOWNLOAD_TIMEOUT_SECONDS=60
INGEST_DOWNLOAD_RETRIES=3
INGEST_ENABLE_CHUNKING=true
INGEST_CACHE_TTL_SECONDS=600
INGEST_CACHE_MAXSIZE=1024

# ---------- 检索阈值 ----------
VECTOR_SIMILARITY_THRESHOLD=0.3

# ---------- 本地模型缓存 ----------
# 语音/视频/文本/图片等本地模型：每次启动/使用优先从指定缓存目录获取，取不到时再下载。
# 留空 = 用各库默认位置（HF: ~/.cache/huggingface，whisper: ~/.cache/whisper）。
# 可指定专用目录（如 D:/model-cache）：
#   HF 模型落 <dir>/huggingface/hub，Whisper 权重落 <dir>/whisper。
MODEL_CACHE_DIR=~/.cache
# 缓存未命中时是否允许联网下载；false = 仅用缓存（离线部署）
MODEL_AUTO_DOWNLOAD=true

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ---------- 七牛云对象存储（echo-ai 直传/删除对象） ----------
QINIU_ACCESS_KEY=L1PcZ8nUNX8XdeGSH0VcdlB5GsjsLfpf3qZ5-4iU
