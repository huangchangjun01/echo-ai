# Echo-AI 环境变量示例（请勿提交真实密钥到仓库）

# ---------- Weaviate ----------
WEAVIATE_HOST=localhost
WEAVIATE_SCHEME=http
WEAVIATE_PORT=8080
WEAVIATE_CLASS=EchoDoc
WEAVIATE_API_KEY=

# ---------- 七牛云 ----------
QINIU_BASE_URL=
QINIU_ALLOWED_SUBDOMAINS=

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=echo_ai
DB_POOL_MIN=1
DB_POOL_MAX=10

# ---------- LLM (OpenAI 兼容) ----------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_SMALL_MODEL=gpt-4o-mini
LLM_SMALL_MAX_TOKENS=64
LLM_SMALL_TEMPERATURE=0.5
LLM_SMALL_BASE_URL=
LLM_SMALL_API_KEY=

# ---------- Embedding ----------
EMBEDDING_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CHUNK_SIZE=256
EMBEDDING_CHUNK_OVERLAP=32
EMBEDDING_WARMUP_ON_START=true

BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DIM=768
BGE_M3_DEVICE=auto

# ---------- 本地模型缓存 ----------
# 语音/视频/文本/图片等本地模型：每次启动/使用优先从指定缓存目录获取，取不到时再下载。
# 留空 = 用各库默认位置（HF: ~/.cache/huggingface，whisper: ~/.cache/whisper）。
# 可指定专用目录（如 D:/model-cache）：
#   HF 模型落 <dir>/huggingface/hub，Whisper 权重落 <dir>/whisper。
MODEL_CACHE_DIR=
# 缓存未命中时是否允许联网下载；false = 仅用缓存（离线部署）
MODEL_AUTO_DOWNLOAD=true

# ---------- 记忆系统 ----------
MEMORY_L0_LIMIT=20
MEMORY_L1_TOPK=8
MEMORY_L2_TOPK=20
MEMORY_DEDUP_THRESHOLD=0.92
MEMORY_REACT_MAX_ITER=3
MEMORY_ENABLE_ASYNC_EXTRACT=true
# 意图识别超时（ms）。推理型小模型给 4000；非推理模型可调回 1500。
MEMORY_INTENT_TIMEOUT_MS=4000

# ---------- Ingest ----------
INGEST_MAX_DOWNLOAD_BYTES=52428800
INGEST_DOWNLOAD_TIMEOUT_SECONDS=60
INGEST_DOWNLOAD_RETRIES=3
INGEST_ENABLE_CHUNKING=true
INGEST_CACHE_TTL_SECONDS=600
INGEST_CACHE_MAXSIZE=1024

VECTOR_SIMILARITY_THRESHOLD=0.3

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO